{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(php tools/phpunit/vendor/bin/phpunit)",
      "Bash(php tools/phpunit/vendor/bin/phpunit *)",
      "Bash(php -l *)",
      "Bash(php -v)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(wc)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(uniq)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(curl *katalysis-pro.test*)",
      "Bash(composer validate)",
      "Bash(composer validate *)",
      "Bash(composer show)",
      "Bash(composer show *)",
      "Bash(composer why *)",
      "Bash(composer depends *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git config *)",
      "Bash(git merge --ff-only *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin task/*)",
      "Bash(git push -u origin task/*)",
      "Bash(git push --set-upstream origin task/*)",
      "Bash(git push origin spike/*)",
      "Bash(git push -u origin spike/*)",
      "Bash(git push --set-upstream origin spike/*)",
      "Bash(git fetch *)",
      "Bash(git ls-remote *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh auth status)",
      "Bash(documentation/fixtures/backup_dev_db.sh *)",
      "Bash(./documentation/fixtures/backup_dev_db.sh *)",
      "WebFetch(domain:docs.neuron-ai.dev)",
      "WebFetch(domain:neuron-ai.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:packagist.org)",
      "WebFetch(domain:repo.packagist.org)",
      "WebFetch(domain:documentation.concretecms.org)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git switch -f *)",
      "Bash(git switch --force *)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch --discard-changes *)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)",
      "Bash(gh pr create)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash *)",
      "Bash(gh api *)",
      "Bash(mysql *)",
      "Bash(mysqldump *)",
      "Bash(php ../../concrete/bin/concrete c5:exec tests/Eval/run_scenarios.php*)",
      "Bash(composer require *)",
      "Bash(composer update)",
      "Bash(composer update *)",
      "Bash(composer install)",
      "Bash(composer install *)",
      "Bash(composer remove *)",
      "Bash(rm *)",
      "Edit(/composer.json)",
      "Edit(/controller.php)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/.ssh/**)",
      "Read(//**/application/config/database.php)",
      "Read(//**/application/config/generated_overrides/katalysis.php)",
      "Edit(/vendor/**)",
      "Bash(git push --force *)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push * development)",
      "Bash(git push *:development)",
      "Bash(git push *:refs/heads/development)",
      "Bash(git push * integration/*)",
      "Bash(git push *:integration/*)",
      "Bash(git push *:refs/heads/integration/*)",
      "Bash(git push --all *)",
      "Bash(git push --mirror *)",
      "Bash(git push --no-verify *)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(mysqladmin *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.php\"" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          { "type": "command", "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.php\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.php\"" }
        ]
      }
    ]
  }
}
