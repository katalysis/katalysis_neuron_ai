{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php tools/phpunit/vendor/bin/phpunit)",
      "Bash(php tools/phpunit/vendor/bin/phpunit *)",
      "Bash(php -l *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh auth status)",
      "Bash(documentation/fixtures/backup_dev_db.sh *)",
      "Bash(./documentation/fixtures/backup_dev_db.sh *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash *)",
      "Bash(gh api *)",
      "Bash(mysql *)",
      "Bash(mysqldump *)",
      "Bash(php ../../concrete/bin/concrete *)",
      "Bash(composer *)",
      "Bash(rm *)",
      "Edit(/composer.json)",
      "Edit(/controller.php)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/.ssh/**)",
      "Read(//**/application/config/database.php)",
      "Read(//**/application/config/generated_overrides/katalysis.php)",
      "Edit(/vendor/**)",
      "Write(/vendor/**)",
      "Bash(git push --force *)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push * development)",
      "Bash(git push *:development)",
      "Bash(git push *:refs/heads/development)",
      "Bash(git push --all *)",
      "Bash(git push --mirror *)",
      "Bash(git push --no-verify *)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(mysqladmin *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.php\"" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          { "type": "command", "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.php\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.php\"" }
        ]
      }
    ]
  }
}
